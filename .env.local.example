# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — server-only, used for the Riot API ingestion job.
# Never expose this to the browser.
SUPABASE_SECRET_KEY=

# Riot Games API key
RIOT_API_KEY=

# Shared secret to trigger /api/update-rankings (choose any random string)
CRON_SECRET=

# Password that protects /admin and /api/participants (choose any random string)
ADMIN_SECRET=

# Signs the /jugador session cookie so it can't be forged into another
# participant's id (choose any random string, different from ADMIN_SECRET)
PLAYER_SESSION_SECRET=
